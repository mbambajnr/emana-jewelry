# Local PostgreSQL. Replace these placeholders with your own database credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/emana_jewelry"

# Admin access. Generate a secret with: openssl rand -hex 32
SESSION_SECRET=""
ADMIN_EMAIL=""
# Run npm run admin:credentials and copy only the resulting hash here.
ADMIN_PASSWORD_HASH=""

# Public production origin used in canonical URLs and WhatsApp product links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required for production image uploads; not needed for local uploads.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional email delivery. Requires a verified emanajewelry.com sender in Resend.
RESEND_API_KEY=""
