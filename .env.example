# MySQL 8.0+ (or MariaDB 10.6+). Replace these placeholders with your own database credentials.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/emana_jewelry"

# Admin access. Generate a secret with: openssl rand -hex 32
SESSION_SECRET=""
ADMIN_EMAIL=""
# Shop enquiry notifications; defaults to ADMIN_EMAIL when blank.
SHOP_NOTIFICATION_EMAIL=""
# Initial/recovery password hash. Change normal passwords in Admin → Security & Password.
# Replacing this bootstrap value intentionally resets the stored password after restart.
# Run npm run admin:credentials and copy only the resulting hash here.
ADMIN_PASSWORD_HASH=""

# Public production origin used in canonical URLs and WhatsApp product links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Persistent image storage. On OrangeHost, use an absolute directory outside the app checkout.
# Keep this directory across deployments and include it in backups.
PRODUCT_IMAGE_DIRECTORY=""
IMAGE_STORAGE="filesystem"

# Optional Supabase alternative: set IMAGE_STORAGE="supabase" and configure these.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Choose smtp or resend. Gmail uses smtp.gmail.com:465 and a Google app password.
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# The authenticated mailbox or an authorized alias; overrides all message From addresses in SMTP mode.
SMTP_FROM=""
# One-time server setup: generate 32 random bytes in base64. Keep it across deployments/backups.
# Encrypts SMTP app passwords saved through Admin → Email Settings. Never expose it to the browser.
EMAIL_SETTINGS_KEY=""

# Resend alternative: set EMAIL_PROVIDER=resend and configure a verified sender.
RESEND_API_KEY=""
# Optional verified sender override for admin login codes; defaults to notifications@emanajewelry.com.
ADMIN_OTP_FROM=""

# Set only after confirming this header is overwritten by the trusted hosting proxy.
# Without it, conservative site-wide submission limits apply.
TRUSTED_CLIENT_IP_HEADER=""

# Optional scheduled notification runner. Generate a separate random secret (32+ characters).
# POST /api/jobs/notifications with Authorization: Bearer <this value> from your scheduler.
NOTIFICATION_CRON_SECRET=""

# OrangeHost operations (private directories outside public_html and the application).
HOSTING_PUBLIC_ROOT="/home/ACCOUNT/public_html"
BACKUP_DIRECTORY="/home/ACCOUNT/emana-backups"
# Separate random secret, stored off-host too. Never reuse the session or email encryption key.
BACKUP_ENCRYPTION_PASSWORD=""
# Optional: build on Linux with ORANGEHOST_STANDALONE=1 for the compact deployment bundle.
# ORANGEHOST_STANDALONE="1"
