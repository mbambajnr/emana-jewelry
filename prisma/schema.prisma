generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String @db.VarChar(300)
  description String @db.Text
  image       String @db.Text
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  version Int @default(0)
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String @db.VarChar(300)
  youtubeUrl     String? @db.Text
  subcategory    String?
  metalOptions   Json           @default("[\"Gold\", \"Silver\"]")
  price          Float
  originalPrice  Float?
  description    String @db.Text
  availabilityStatus String?
  sizeNotes      String? @db.Text
  deliveryNotes  String? @db.Text
  careInstructions String? @db.Text
  available      Boolean        @default(true)
  sku            String         @unique
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  materials      Material[]
  stones         Stone[]
  reviews        Review[]
  details        ProductDetail[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProductImage {
  metal     String?
  alt       String  @default("") @db.VarChar(500)
  id        String  @id @default(cuid())
  url       String @db.Text
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Material {
  id        String  @id @default(cuid())
  metal     String
  purity    String
  weight    String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Stone {
  id             String  @id @default(cuid())
  type           String
  carat          String
  clarity        String?
  color          String?
  cut            String?
  certification  String?
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductDetail {
  id        String  @id @default(cuid())
  text      String @db.Text
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        String  @id @default(cuid())
  author    String
  rating    Int
  text      String @db.Text
  date      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductView {
  id String @id @default(cuid())
  productSlug String
  createdAt DateTime @default(now())
  @@index([createdAt, productSlug])
}

model WhatsAppClick {
  productSlug String?
  metal String?
  id        String   @id @default(cuid())
  source    String @db.VarChar(512)
  label     String? @db.VarChar(512)
  product   String? @db.VarChar(512)
  createdAt DateTime @default(now())
}

model Order {
  requestKey String? @unique @db.VarChar(64)
  requestFingerprint String? @db.VarChar(64)
  id        String   @id @default(cuid())
  name      String @db.VarChar(300)
  email     String @db.VarChar(254)
  phone     String
  address   String @db.Text
  notes     String? @db.Text
  total     Float
  items     Json
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consultation {
  requestKey String? @unique @db.VarChar(64)
  requestFingerprint String? @db.VarChar(64)
  id        String   @id @default(cuid())
  name      String @db.VarChar(300)
  email     String @db.VarChar(254)
  phone     String?
  service   String @db.Text
  notes     String @db.Text
  format    String
  date      String
  status    String   @default("requested")
  createdAt DateTime @default(now())
}

model SearchSettings {
  id                 String   @id @default("site")
  googleVerification String   @default("") @db.VarChar(512)
  bingVerification   String   @default("") @db.VarChar(512)
  updatedAt          DateTime @updatedAt
}

model SocialSettings {
  id        String   @id @default("site")
  instagram String   @default("") @db.VarChar(2048)
  facebook  String   @default("") @db.VarChar(2048)
  tiktok    String   @default("") @db.VarChar(2048)
  updatedAt DateTime @updatedAt
}

model RequestActivity {
  id          String   @id @default(cuid())
  requestKind String
  requestId   String
  fromStatus  String
  toStatus    String
  note        String @db.Text
  actor       String @db.VarChar(254)
  createdAt   DateTime @default(now())
  @@index([requestKind, requestId, createdAt])
}

model SiteContent {
  id          String   @id @default("site")
  draft       Json
  published   Json
  version     Int      @default(0)
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt
}

model ContentRevision {
  id        String   @id @default(cuid())
  content   Json
  action    String
  actor     String @db.VarChar(254)
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model RateBucket {
  key String @id @db.VarChar(191)
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model NotificationJob {
  id String @id @default(cuid())
  kind String @db.VarChar(40)
  recordId String @db.VarChar(191)
  status String @default("pending") @db.VarChar(20)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedUntil DateTime?
  lockToken String? @db.VarChar(64)
  lastError String? @db.VarChar(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([kind, recordId])
  @@index([status, nextAttemptAt])
}
